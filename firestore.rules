rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isAuthenticated() && getUserData().role == role;
    }

    function isDoctor() {
      return hasRole('doctor') || hasRole('admin');
    }

    function isReceptionist() {
      return hasRole('receptionist') || hasRole('admin');
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function isStaff() {
      return isDoctor() || isReceptionist() || isAdmin();
    }

    function isSelf(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // Users Collection - Strict anti-escalation
    match /users/{userId} {
      allow read: if isAuthenticated();
      // Only admin can create non-patient profiles; self-signup can only create patient role
      allow create: if isAuthenticated() && (
        isAdmin() ||
        (isSelf(userId) && (!('role' in request.resource.data) || request.resource.data.role == 'patient'))
      );
      // Users can update their profile (e.g. name), but CANNOT change their role.
      // Only an admin can change user roles.
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (isSelf(userId) && request.resource.data.role == resource.data.role)
      );
      allow delete: if isAdmin();
    }

    // Patients Collection (Internal ID / verified phone)
    match /patients/{patientRecordId} {
      // Staff can view all patient records.
      // Patient can ONLY read their own record matching their authenticated phone number.
      allow read: if isStaff() || (isAuthenticated() && request.auth.token.phone_number == resource.data.phone);
      // Receptionist & Admin can register/update patient demographic details
      allow create, update: if isReceptionist();
      allow delete: if isAdmin();
    }

    // Appointments Collection
    match /appointments/{appointmentId} {
      // Staff can read all appointments. Patient can only read appointments matching their verified phone.
      allow read: if isStaff() || (isAuthenticated() && request.auth.token.phone_number == resource.data.patientPhone);
      // Receptionist & Admin can create appointments and update their status
      allow create, update: if isReceptionist();
      // Doctor can update appointment status (e.g. mark 'in-consultation' or 'completed')
      allow update: if isDoctor();
      allow delete: if isAdmin();
    }

    // Consultations Collection
    match /consultations/{consultationId} {
      // Staff can read all consultations.
      // Patient can ONLY read their own consultations matching their verified phone.
      allow read: if isStaff() || (isAuthenticated() && request.auth.token.phone_number == resource.data.patientPhone);
      // ONLY Doctors can create consultations, and doctorId must match caller
      allow create: if isDoctor() && request.resource.data.doctorId == request.auth.uid;
      // Doctor can only update their own draft/in-progress consultations; finalized consultations are immutable
      allow update: if isDoctor() && resource.data.doctorId == request.auth.uid && resource.data.status != 'finalized';
      // Consultations are medical records and cannot be deleted
      allow delete: if isAdmin();
    }

    // Prescriptions Collection
    match /prescriptions/{prescriptionId} {
      // Staff can read all prescriptions.
      // Patient can ONLY read their own prescription matching their verified phone.
      allow read: if isStaff() || (isAuthenticated() && request.auth.token.phone_number == resource.data.patientPhone);
      // ONLY Doctors can generate prescriptions, doctorId must match caller
      allow create: if isDoctor() && request.resource.data.doctorId == request.auth.uid;
      // Prescriptions are permanent legal records and cannot be modified once generated
      allow update: if false;
      // Prescriptions cannot be deleted
      allow delete: if false;
    }

    // Medications Master Collection
    match /medications/{medicationId} {
      // Staff (Doctor, Receptionist, Admin) can read medication master; Patient has no access
      allow read: if isStaff();
      // Only admin can add, update, or deactivate master catalog items
      allow create, update, delete: if isAdmin();
    }

    // Treatments Master Collection (Kurnool Reference Tariff)
    match /treatments/{treatmentId} {
      // Staff can view reference prices
      allow read: if isStaff();
      // Only admin can configure treatment master prices
      allow create, update, delete: if isAdmin();
    }

    // Audit Logs Collection (Append-only & tamper-proof)
    match /auditLogs/{logId} {
      // Authenticated users can write audit records for their own actions
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      // Staff / Admin can review audit logs
      allow read: if isStaff();
      // Audit logs cannot be edited or deleted
      allow update, delete: if false;
    }

    // Clinic Feedback Collection
    match /clinicFeedback/{feedbackId} {
      allow create: if isAuthenticated();
      allow read: if isStaff();
      allow update, delete: if isAdmin();
    }
  }
}
